PORT=3000
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional. Leave unset for local dev (uses ./media, and ./data/db.json if DATABASE_URL
# below is also unset). On Railway, set this to your mounted volume's exact mount path
# (e.g. /app/data) so uploaded media persists across deploys.
# STORAGE_DIR=/app/data

# Optional. Leave unset for local dev (falls back to data/db.json). On Railway, set this
# to your Postgres service's DATABASE_URL (use the internal one if the DB is in the same
# project, e.g. via a variable reference like ${{Postgres.DATABASE_URL}}) so categories,
# tracks, rotation, settings, and layout persist in a real database instead of a file.
# DATABASE_URL=postgresql://user:password@host:5432/railway
