PORT=3000
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional. Leave unset for local dev (uses ./data and ./media). On Railway, set this
# to your single mounted volume's path (e.g. /app/storage) so db.json and uploaded
# media both persist across deploys under one volume.
# STORAGE_DIR=/app/storage
